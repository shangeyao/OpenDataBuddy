# ---- OpenDataBuddy 环境变量（全部可选，也可在「设置」页里配） ----

# 数据目录：元数据库、湖仓文件、上传文件、知识库都放这里
# DATABUDDY_DATA_DIR=./data

# 首次启动创建的管理员账号（默认 admin@local / admin123）
# DATABUDDY_ADMIN_EMAIL=admin@local
# DATABUDDY_ADMIN_PASSWORD=admin123

# 监听地址与端口
# DATABUDDY_HOST=127.0.0.1
# DATABUDDY_PORT=8000

# ---- 大模型（DeepSeek 为默认底座，OpenAI 兼容协议） ----
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 也可用任意 OpenAI 兼容端点（Qwen / Kimi / 硅基流动 / vLLM / Ollama）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:14b

# 未配置任何 API Key 时，Agent 自动降级为内置规则引擎（可用，但泛化能力有限）

# 业务日期与默认 cron 时区
# DATABUDDY_TIMEZONE=Asia/Shanghai

# 仅 Notebook / Python 节点需要 Python 3.10+（无 pip 依赖）
# DATABUDDY_PYTHON=python3
