4181", "tag": "身份证号", "level": "L3", "source": "ai", "confidence": 0.95, "evidence": "列名匹配 /id_?card|identity|身份证/", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "54fa5418882a4b6a", "column_id": "23cebabd2300437e", "tag": "姓名", "level": "L2", "source": "ai", "confidence": 0.7, "evidence": "列名匹配 /(^|_)(name|full_name)(_|$)|姓名/", "created_at": "2026-11-10T12:28:05+08:00"}], "lineage": [{"id": "1dab295627454282", "workspace_id": "94d133c123d444bc", "upstream": "demo.retail.fact_orders", "downstream": "demo.retail.dim_customer", "kind": "sql", "detail": "订单事实表通过 customer_id 关联客户维度", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "45f1a1e8305a4b6c", "workspace_id": "94d133c123d444bc", "upstream": "demo.retail.fact_orders", "downstream": "demo.retail.dim_product", "kind": "sql", "detail": "订单事实表通过 customer_id 关联客户维度", "created_at": "2026-11-10T12:28:05+08:00"}], "metrics": [{"id": "dc6e44194df343ac", "workspace_id": "94d133c123d444bc", "name": "gmv", "display_name": "GMV", "description": "成交总额，口径为订单金额之和，含未退款订单", "expr": "sum(f.amount)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "元", "dimensions": "[\"order_date\", \"channel_name\", \"category\", \"city\", \"gender\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "f197e7aca4be4c90", "workspace_id": "94d133c123d444bc", "name": "order_cnt", "display_name": "订单量", "description": "去重订单数，一行订单商品明细折成一个订单", "expr": "count(DISTINCT f.order_id)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "单", "dimensions": "[\"order_date\", \"channel_name\", \"category\", \"city\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "0a1e6d30376c4e54", "workspace_id": "94d133c123d444bc", "name": "avg_order_value", "display_name": "客单价", "description": "GMV / 订单量，反映单笔成交能力", "expr": "sum(f.amount) / nullif(count(DISTINCT f.order_id), 0)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "元", "dimensions": "[\"order_date\", \"channel_name\", \"category\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "c547b0dd32de48ba", "workspace_id": "94d133c123d444bc", "name": "customer_cnt", "display_name": "成交客户数", "description": "当期有成交的去重客户数", "expr": "count(DISTINCT f.customer_id)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "人", "dimensions": "[\"order_date\", \"city\", \"member_level\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "48b91fd9e7fd456c", "workspace_id": "94d133c123d444bc", "name": "refund_rate", "display_name": "退款率", "description": "退款订单数 / 订单总数", "expr": "sum(CASE WHEN f.status = 'refund' THEN 1 ELSE 0 END) * 1.0 / nullif(count(*), 0)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "%", "dimensions": "[\"order_date\", \"channel_name\", \"category\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "d7d14f7ebaa44797", "workspace_id": "94d133c123d444bc", "name": "qty", "display_name": "销量", "description": "售出商品件数", "expr": "sum(f.quantity)", "table_ref": "demo.retail.fact_orders", "filters": "", "unit": "件", "dimensions": "[\"order_date\", \"category\", \"brand\"]", "joins": "[{\"table\": \"demo.retail.dim_customer\", \"alias\": \"dc\", \"on\": \"dc.customer_id = f.customer_id\", \"columns\": [\"city\", \"gender\", \"member_level\", \"customer_name\"]}, {\"table\": \"demo.retail.dim_product\", \"alias\": \"dp\", \"on\": \"dp.product_id = f.product_id\", \"columns\": [\"category\", \"brand\", \"product_name\"]}, {\"table\": \"demo.retail.dim_channel\", \"alias\": \"dh\", \"on\": \"dh.channel_id = f.channel_id\", \"columns\": [\"channel_name\", \"channel_type\"]}]", "owner": "admin", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}], "knowledge_docs": [{"id": "ec2427a4835a4f42", "workspace_id": "94d133c123d444bc", "title": "数仓分层规范", "content": "ODS：原始贴源层，结构与源系统一致，只做同步不做加工。\nDWD：明细层，完成清洗、去重、维度关联，保留业务过程粒度。\nDWS：汇总层，按主题聚合的宽表，供分析与看板使用。\nDIM：公共维度层，客户、商品、渠道等一致性维度。\nADS：应用层，面向具体报表与 Agent 消费的结果表。\n命名规则：层级前缀 + 业务域 + 描述，例如 dwd_trade_order_detail。", "source_type": "manual", "tags": "规范", "scope": "workspace", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}, {"id": "a2d39a8f86604708", "workspace_id": "94d133c123d444bc", "title": "指标口径说明", "content": "GMV = sum(amount)，统计已支付与已退款订单，退款不回冲，另用退款率单独监控。\n订单量 = count(distinct order_id)，一行订单商品明细折成一个订单。\n客单价 = GMV / 订单量，保留两位小数。\n成交客户数 = count(distinct customer_id)，按自然月去重。\n退款率 = 退款订单数 / 订单总数，按订单数而非金额计算。", "source_type": "manual", "tags": "指标", "scope": "workspace", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}, {"id": "9c002f76d7534306", "workspace_id": "94d133c123d444bc", "title": "业务术语表", "content": "渠道：指订单来源，分为电商平台（天猫、京东）、内容电商（抖音直播）、线下门店、私域（小程序商城）。\n会员等级：黄金 / 白银 / 普通，按近 12 个月累计消费划分。\n动销：统计周期内产生过订单的商品。\n连带率：单个订单平均包含的商品件数。", "source_type": "manual", "tags": "术语", "scope": "workspace", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}, {"id": "3ec2c90453444feb", "workspace_id": "94d133c123d444bc", "title": "敏感数据与合规要求", "content": "客户手机号、邮箱、身份证号属于个人敏感信息（PII），对外提供数据时必须脱敏。\n手机号保留前 3 后 4，中间用 * 掩码；身份证号保留前 6 后 4。\n涉及个人信息导出的需求需数据管理员审批，并记录审计日志。\n合规框架参考《个人信息保护法》（PIPL）与 GDPR 的数据最小化原则。", "source_type": "manual", "tags": "合规", "scope": "workspace", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}], "flows": [{"id": "7d4f2a8fade44ed0", "workspace_id": "94d133c123d444bc", "name": "每日经营数据刷新", "description": "示例工作流：销售汇总 → 质量校验 → 品类贡献，每天 07:00 调度", "nodes": "[{\"id\": \"n1\", \"type\": \"sql\", \"name\": \"构建每日销售汇总\", \"config\": {\"sql\": \"SELECT order_date, sum(amount) AS gmv, count(DISTINCT order_id) AS order_cnt, count(DISTINCT customer_id) AS customer_cnt FROM demo.retail.fact_orders GROUP BY order_date ORDER BY order_date\"}}, {\"id\": \"n2\", \"type\": \"quality\", \"name\": \"校验订单金额非空\", \"config\": {\"sql\": \"SELECT count(*) AS bad FROM demo.retail.fact_orders WHERE amount IS NULL\"}}, {\"id\": \"n3\", \"type\": \"sql\", \"name\": \"输出品类贡献\", \"config\": {\"sql\": \"SELECT p.category, sum(o.amount) AS gmv FROM demo.retail.fact_orders o JOIN demo.retail.dim_product p ON p.product_id = o.product_id GROUP BY 1 ORDER BY gmv DESC\"}}]", "edges": "[[\"n1\", \"n2\"], [\"n2\", \"n3\"]]", "cron": "0 7 * * *", "enabled": 1, "retries": 0, "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}], "dashboards": [{"id": "e4b7e8360da447b9", "workspace_id": "94d133c123d444bc", "name": "零售经营总览", "description": "示例看板，由语义层指标直接生成", "spec": "{\"cards\": [{\"title\": \"近 30 天 GMV 趋势\", \"chart\": {\"type\": \"line\", \"x\": 0, \"y\": 1}, \"sql\": \"SELECT * FROM (SELECT order_date, round(sum(amount), 2) AS gmv FROM demo.retail.fact_orders GROUP BY 1 ORDER BY 1 DESC LIMIT 30) t ORDER BY order_date\"}, {\"title\": \"渠道销售占比\", \"chart\": {\"type\": \"pie\", \"x\": 0, \"y\": 1}, \"sql\": \"SELECT c.channel_name, round(sum(o.amount), 2) AS gmv FROM demo.retail.fact_orders o JOIN demo.retail.dim_channel c ON c.channel_id = o.channel_id GROUP BY 1 ORDER BY gmv DESC\"}, {\"title\": \"品类排行\", \"chart\": {\"type\": \"bar\", \"x\": 0, \"y\": 1}, \"sql\": \"SELECT p.category, round(sum(o.amount), 2) AS gmv FROM demo.retail.fact_orders o JOIN demo.retail.dim_product p ON p.product_id = o.product_id GROUP BY 1 ORDER BY gmv DESC\"}, {\"title\": \"大区客户分布\", \"chart\": {\"type\": \"bar\", \"x\": 0, \"y\": 1}, \"sql\": \"SELECT c.city, count(DISTINCT o.customer_id) AS customers FROM demo.retail.fact_orders o JOIN demo.retail.dim_customer c ON c.customer_id = o.customer_id GROUP BY 1 ORDER BY customers DESC\"}]}", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}], "quality_rules": [{"id": "e665ce3a35534269", "workspace_id": "94d133c123d444bc", "table_ref": "demo.retail.fact_orders", "column_name": "amount", "rule_type": "null_rate", "config": "{\"max_rate\": 0}", "enabled": 1, "last_status": "pass", "last_value": "0.00%", "last_run_at": "2026-11-10T12:28:05+08:00", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "1b253dfd07884e14", "workspace_id": "94d133c123d444bc", "table_ref": "demo.retail.fact_orders", "column_name": "order_id", "rule_type": "uniqueness", "config": "{\"max_dup\": 0}", "enabled": 1, "last_status": "pass", "last_value": "重复 0", "last_run_at": "2026-11-10T12:28:05+08:00", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "bb42f77922324e91", "workspace_id": "94d133c123d444bc", "table_ref": "demo.retail.fact_orders", "column_name": "amount", "rule_type": "range", "config": "{\"min\": 0, \"max\": 1000000}", "enabled": 1, "last_status": "pass", "last_value": "越界 0", "last_run_at": "2026-11-10T12:28:05+08:00", "created_at": "2026-11-10T12:28:05+08:00"}], "compute_resources": [{"id": "e23f947ea55e458c", "workspace_id": "94d133c123d444bc", "name": "demo_job_cluster", "description": "POC 作业集群，跑 Notebook 与 Python 任务", "type": "job", "engine": "Spark", "compute_type": "CPU", "image": "Standard-S 1.1", "cu": 64, "status": "running", "network": "", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "a30d22d21df349e2", "workspace_id": "94d133c123d444bc", "name": "demo_interactive", "description": "交互式查询集群，供 SQL 探索与看板使用", "type": "interactive", "engine": "Spark", "compute_type": "CPU", "image": "Standard-S 1.1", "cu": 32, "status": "stopped", "network": "", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "f8e5f5fe224b4e8f", "workspace_id": "94d133c123d444bc", "name": "demo_platform", "description": "平台集群，承载离线接入与连通性测试", "type": "platform", "engine": "平台服务", "compute_type": "CPU", "image": "Standard-S 1.1", "cu": 16, "status": "running", "network": "vpc-demo / subnet-1", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "a0839b9034374be3", "workspace_id": "94d133c123d444bc", "name": "demo_realtime", "description": "实时集群，承载 Flink 实时接入", "type": "realtime", "engine": "Flink", "compute_type": "CPU", "image": "Standard-S 1.1", "cu": 32, "status": "running", "network": "vpc-demo / subnet-1", "created_at": "2026-11-10T12:28:05+08:00"}], "model_experiments": [{"id": "231ed2a84e934eee", "workspace_id": "94d133c123d444bc", "name": "churn_prediction_lgb", "framework": "LightGBM", "status": "success", "metrics": "{\"auc\": 0.862, \"f1\": 0.74, \"样本\": 52000}", "owner": "管理员", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}, {"id": "934373ee49d8454f", "workspace_id": "94d133c123d444bc", "name": "gmv_forecast_prophet", "framework": "Prophet", "status": "success", "metrics": "{\"mape\": 0.081, \"horizon\": 30}", "owner": "管理员", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}, {"id": "08ec1a16b6614462", "workspace_id": "94d133c123d444bc", "name": "repurchase_uplift", "framework": "XGBoost", "status": "running", "metrics": "{\"uplift@10%\": 0.127}", "owner": "管理员", "created_at": "2026-11-10T12:28:05+08:00", "updated_at": "2026-11-10T12:28:05+08:00"}], "model_services": [{"id": "a1959b87147f49da", "workspace_id": "94d133c123d444bc", "name": "churn_score_api", "model_ref": "churn_prediction_lgb", "version": "v3", "replicas": 2, "status": "running", "endpoint": "/svc/churn-score", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "0e8f2cbde81b401b", "workspace_id": "94d133c123d444bc", "name": "gmv_forecast_api", "model_ref": "gmv_forecast_prophet", "version": "v1", "replicas": 1, "status": "stopped", "endpoint": "/svc/gmv-forecast", "created_at": "2026-11-10T12:28:05+08:00"}], "agents": [{"id": "89ee6d41b31249fc", "workspace_id": "94d133c123d444bc", "name": "数仓建设助手", "mode": "engineering", "description": "从一句需求生成分层方案、DDL、ETL 与调度", "prompt": "你是数据工程专家。先用 list_tables 看资产，再给分层方案，SQL 必须可执行。", "tools": "[\"list_tables\", \"describe_table\", \"run_query\", \"query_metric\"]", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "f966c83418e34ac8", "workspace_id": "94d133c123d444bc", "name": "合规治理官", "mode": "governance", "description": "敏感字段扫描、分级打标与质量规则巡检", "prompt": "你是数据治理专家。每次判定都要给证据与置信度，按 L1~L4 分级。", "tools": "[\"list_tables\", \"describe_table\", \"run_query\", \"query_metric\"]", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "151e1aec19ae4ec7", "workspace_id": "94d133c123d444bc", "name": "经营分析官", "mode": "analysis", "description": "问数、异动归因、日报与看板生成", "prompt": "你是数据分析专家。结论先行，给对比、构成、趋势三类依据。", "tools": "[\"list_tables\", \"describe_table\", \"run_query\", \"query_metric\"]", "status": "published", "created_at": "2026-11-10T12:28:05+08:00"}], "apps": [{"id": "3918aee6170b48fc", "workspace_id": "94d133c123d444bc", "name": "门店经营速览", "type": "dashboard", "description": "面向店长的经营看板，嵌出到企业微信", "entry": "/dashboards", "status": "online", "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "93d73c2a3e6b48e2", "workspace_id": "94d133c123d444bc", "name": "供应商对账助手", "type": "chat", "description": "对账差异问询，只读访问订单与结算表", "entry": "/buddy", "status": "online", "created_at": "2026-11-10T12:28:05+08:00"}], "buddy_tasks": [{"id": "e54039d8ecf74fa6", "workspace_id": "94d133c123d444bc", "user_id": null, "name": "每日经营早报", "prompt": "汇总昨日 GMV、订单量、退款率，与上周同期对比，生成早报", "cron": "0 9 * * *", "enabled": 1, "last_run": null, "created_at": "2026-11-10T12:28:05+08:00"}, {"id": "781a31419a894374", "workspace_id": "94d133c123d444bc", "user_id": null, "name": "每周质量巡检", "prompt": "对所有已启用质量规则跑一遍，汇总未通过项并给出修复建议", "cron": "0 8 * * 1", "enabled": 1, "last_run": null, "created_at": "2026-11-10T12:28:05+08:00"}], "analysis_spaces": [{"id": "1b4ae9bd63b24f58", "workspace_id": "94d133c123d444bc", "name": "零售经营分析", "description": "面向业务方的经营分析空间，绑定订单事实表与核心指标", "tables": "[\"demo.retail.fact_orders\", \"demo.retail.dim_channel\", \"demo.retail.dim_product\"]", "metrics": "[\"gmv\", \"order_cnt\", \"avg_order_value\", \"refund_rate\"]", "owner": "管理员", "created_at": "2026-11-10T12:28:05+08:00"}]}